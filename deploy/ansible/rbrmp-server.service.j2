# {{ ansible_managed }}
[Unit]
Description=RBR-MP multiplayer relay (UDP {{ rbrmp_port }})
After=network-online.target
Wants=network-online.target

[Service]
{% if rbrmp_rcon_password %}
# RCON on localhost only - administrate over an SSH tunnel, never the open
# internet. The password rides in the environment, not on the command line.
Environment=RBRMP_RCON_PASSWORD={{ rbrmp_rcon_password }}
ExecStart=/opt/rbrmp/rbrmp-server -addr :{{ rbrmp_port }} -rcon-addr {{ rbrmp_rcon_addr }} -bans /var/lib/rbrmp/bans.json {{ rbrmp_flags }}
{% else %}
ExecStart=/opt/rbrmp/rbrmp-server -addr :{{ rbrmp_port }} -bans /var/lib/rbrmp/bans.json {{ rbrmp_flags }}
{% endif %}
User=rbrmp
Group=rbrmp
Restart=always
RestartSec=2

# The process needs a UDP socket and the ban file; take everything else away.
StateDirectory=rbrmp
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
